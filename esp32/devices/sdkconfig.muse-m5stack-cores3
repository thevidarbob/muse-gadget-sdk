# M5Stack CoreS3: ESP32-S3 (16 MB flash, 8 MB quad PSRAM), 2" 320x240
# touch LCD, native USB (USB Serial/JTAG, no bridge chip). Load last, after
# sdkconfig.muse, which already sets 16 MB and partitions_muse.csv.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_M5STACK_CORES3=y
# Muse Jam: the music tile right of Muse (components/muse/muse_jam.c).
CONFIG_MUSE_JAM=y

CONFIG_SPIRAM=y
# Quad, not octal: octal PSRAM would take GPIO 33..37, which carry the
# LCD's SPI and DC and the I2S clocks here, and the PSRAM check at boot
# fails, leaving the screen black.
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# As on the Waveshare S3: static buffers in PSRAM, or light sleep's code
# leaves Link too little DMA RAM to open the tunnel.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
# The Jam tile's small labels.
CONFIG_LV_FONT_MONTSERRAT_12=y

# Screen off on battery: light sleep between polls of the PWR key, as on the
# Waveshare S3 (see sdkconfig.muse-waveshare-s3-175c). No 32 kHz crystal.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP is not set
# CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND is not set
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
CONFIG_PM_PROFILING=y
